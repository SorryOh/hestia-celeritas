{
  "schemaVersion": 1,
  "id": "celeritas",
  "version": "${version}",
  "name": "Celeritas (Hestia build)",
  "description": "Celeritas's terrain renderer for Minecraft 1.8.9 on Ornithe. An unofficial build made for Hestia: please don't report problems with it to Celeritas's developers.",
  "authors": ["embeddedt"],
  "contributors": ["JellySquid", "IMS212"],
  "contact": {
    "sources": "https://git.taumc.org/embeddedt/celeritas"
  },
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.taumc.celeritas.impl.Celeritas"
    ]
  },
  "mixins": [
    "mixins.celeritas.json"
  ],
  "accessWidener": "celeritas.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "1.8.9",
    "java": ">=21",
    "pylon": "*"
  },
  "custom": {
    "sarcio:disable": [
      "bugfix.render.WorldRendererMixin"
    ]
  }
}
